{
  "mcpServers": {
    "serial-capture-logs": {
      "type": "stdio",
      "command": "${workspaceFolder}/target/debug/serial-capture-mcp",
      "env": {
        "SERIAL_CAPTURE_LOG_DIR": "${workspaceFolder}/logs",
        "MCP_AUDIT_PATH": "${workspaceFolder}/logs/mcp-audit.jsonl",
        "MCP_CALLER_IDENTITY": "agent:cursor-host"
      }
    }
  }
}
