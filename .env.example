# Optional compose overrides. The CLI reads flags, not these variables.
# BAUD=115200
# DEVICE=/dev/ttyUSB0

# MCP server (serial-capture-mcp). Do not commit real HMAC or gateway tokens.
# SERIAL_CAPTURE_LOG_DIR=./logs
# MCP_AUDIT_PATH=./logs/mcp-audit.jsonl
# MCP_CALLER_IDENTITY=agent:cursor-host
# MCP_SCOPES=devices:list,logs:read,inventory:read
# MCP_REQUIRE_SCOPES=1
# MCP_HMAC_KEY=
# MCP_REQUIRE_SIGNING=1
# MCP_GATEWAY_TOKEN=
# MCP_CALLER_TOKEN=
